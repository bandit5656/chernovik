              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
            });

            if (res.ok) {
              const resData = await res.json();
              photoDescription = resData.candidates?.[0]?.content?.parts?.[0]?.text ?? "";
