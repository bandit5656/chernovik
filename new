// Оптимизированный вызов AI с быстрым ответом и контролем токенов
async function callAI(messages: Array<{ role: string; content: string }>, expectJson = false, temperature = 0.8) {
  const apiKey = getDeepSeekApiKey();

  const res = await fetch("https://api.deepseek.com/v1/chat/completions", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "Authorization": `Bearer ${apiKey}`,
    },
    body: JSON.stringify({
      model: "deepseek-chat",
      messages,
      temperature,
      max_tokens: 600, // Жесткое ограничение длины вывода для моментального завершения
      ...(expectJson ? { response_format: { type: "json_object" } } : {}),
    }),
  });

  if (res.status === 429) throw new HttpError(429, "Превышен лимит запросов к DeepSeek. Попробуйте позже.");
  if (res.status === 402) throw new HttpError(402, "На балансе DeepSeek кончились средства.");
  if (!res.ok) throw new HttpError(res.status, `Ошибка DeepSeek API: ${await res.text()}`);

  const data = await res.json();
  return data.choices?.[0]?.message?.content ?? "";
}

async function runWithAttempt<T>(fn: () => Promise<T>): Promise<T & { remaining: number }> {
  const ctx = await consumeAttemptFromSession();
  try {
    const result = await fn();
    return { ...result, remaining: ctx.remaining } as T & { remaining: number };
  } catch (err) {
    await refundAttempt(ctx.supabase, ctx.userId);
    throw err;
  }
}

function cleanMarkdown(text: string): string {
  let cleaned = text
    .replace(/\*\*/g, "")
    .replace(/\*/g, "")
    .replace(/^#+\s*/gm, "")
    .replace(/`/g, "")
    .trim();

  if (cleaned.includes("🛠 ДИАГНОСТИКА СИСТЕМЫ")) {
    cleaned = cleaned.split("🛠 ДИАГНОСТИКА СИСТЕМЫ")[0].trim();
  }
  if (cleaned.includes("🛠 [1. VISION SERVICE]")) {
    cleaned = cleaned.split("🛠 [1. VISION SERVICE]")[0].trim();
  }

  return cleaned;
}

// Пост-обработка: гарантия отсутствия оборванных слов, заглавной буквы после заголовка и корректных процентов
function postProcessClean(text: string): string {
  let cleaned = cleanMarkdown(text);
  
  // 1. Замена вариаций прописи процентов на знак %
  cleaned = cleaned.replace(/(\d+)\s*(процентов|процента|процент|проц\.?)/gi, "$1%");

  // 2. Делаем первую букву после заголовка заглавной
  const lines = cleaned.split("\n");
  if (lines.length > 1) {
    for (let i = 1; i < lines.length; i++) {
      const trimmed = lines[i].trim();
      if (trimmed.length > 0) {
        lines[i] = lines[i].replace(/^(\s*)([а-яa-z])/u, (_, space, char) => space + char.toUpperCase());
        break;
      }
    }
  }
  return lines.join("\n").trim();
}

const nicheSchema = z.string().trim().min(1).max(40).optional().default("beauty");
const LINE_LIMITS: Record<string, number> = { short: 6, medium: 12, long: 18 };

function enforceLineLimit(text: string, maxLines: number): string {
  const lines = text
    .split("\n")
    .map((l) => l.trimEnd())
    .filter((l, i, arr) => !(l === "" && arr[i - 1] === ""));

  while (lines.length > 0 && lines[lines.length - 1] === "") lines.pop();
  if (lines.length <= maxLines) return lines.join("\n");

  const trimmed = [...lines];
  for (let i = trimmed.length - 2; i > 0 && trimmed.length > maxLines; i--) {
    if (trimmed[i] === "") trimmed.splice(i, 1);
  }
  if (trimmed.length <= maxLines) return trimmed.join("\n");

  const head = trimmed.slice(0, maxLines - 2);
  const tail = trimmed[trimmed.length - 1];
  return [...head, "", tail].join("\n").replace(/\n{3,}/g, "\n\n");
}

function isOfferPost(postType: string, details: string): boolean {
  const t = `${postType} ${details}`.toLowerCase();
  return /акц|скид|%|окош|свободн|запис|подар|дедлайн|последн|мест[оа]|сегодня|завтра|выходн|понедельник|вторник|сред|четверг|пятниц|суббот|воскрес|\d{1,2}[.:/]\d{1,2}|\d+\s*(₽|руб)/.test(
    t,
  );
}

